# Cloudflare Pages SPA fallback for client-rendered dynamic routes.
#
# `output: "export"` pre-renders a single `index` shell per dynamic segment.
# These rules rewrite (200 = proxy, URL unchanged) every real id to that shell
# so the client can read the id from the URL on refresh / direct navigation.

/editor/*  /editor/index.html  200
/ref/*     /ref/index.html     200
