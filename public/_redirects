# Host fallbacks (Cloudflare Pages / Netlify `_redirects` syntax).
#
# The editor is now a REAL static route at `/editor` that reads `?id=<uuid>`
# (e.g. /editor?id=a30a0584-...), so no rewrite is required for it. These rules
# only exist so legacy `/editor/<uuid>` and per-user `/ref/<uuid>` links keep
# working on hosts that support `_redirects`.

/editor/*  /editor.html      200
/ref/*     /ref/index.html   200

# Retire the old fitness-calibration page so crawlers drop it.
/quiz      /  301
/quiz/*    /  301
