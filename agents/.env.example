# ── LLM provider ────────────────────────────────────────────────────────────
# Default provider: DeepSeek (OpenAI-compatible API).
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Used when CREW_LLM_PROVIDER=openai or openai-compatible.
# For a local server (Ollama/llama.cpp/vLLM) set OPENAI_API_BASE and put any
# non-empty placeholder in OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_API_BASE=

# deepseek | openai | openai-compatible
CREW_LLM_PROVIDER=deepseek
# LiteLLM model id:
#   deepseek/deepseek-chat
#   openai/gpt-4o-mini
#   openai/<local-model-name>   (with OPENAI_API_BASE set)
CREW_MODEL=deepseek/deepseek-chat
CREW_TEMPERATURE=0.2
CREW_VERBOSE=false

# ── Dev-team CLI ────────────────────────────────────────────────────────────
# Default parallel workers for multiple features (1-8).
AGENTS_MAX_WORKERS=3
# Optional repo root override. Empty = the Forgevyn repo containing agents/.
AGENTS_REPO_ROOT=

# Privacy: opt out of CrewAI's OpenTelemetry tracing for local-first use.
OTEL_SDK_DISABLED=true
